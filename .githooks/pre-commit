#!/usr/bin/env bash
# Refuses a commit when a figure in the staged README.md is missing from the career toolkit's
# master facts. The toolkit's scripts/check-staged.sh runs the check on the staged files, so
# an unstaged edit cannot change the verdict. Enable with: git config core.hooksPath .githooks
set -euo pipefail
toolkit=$(git config --get --type=path career.toolkit || true)
if [[ -z "$toolkit" ]]; then
  echo "pre-commit: set \`git config career.toolkit <path to the career-toolkit checkout>\`." >&2
  exit 1
fi
if [[ ! -f "$toolkit/scripts/check-staged.sh" ]]; then
  echo "pre-commit: $toolkit has no scripts/check-staged.sh; point career.toolkit at an up-to-date toolkit checkout." >&2
  exit 1
fi
bash "$toolkit/scripts/check-staged.sh" profile
